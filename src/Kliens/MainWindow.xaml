<Window x:Class="Leltarkezelo.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Leltarkezelo.Client.ViewModels" Title="Leltárkezelő" Height="760" Width="1280" MinHeight="600" MinWidth="960" Background="{StaticResource Background}">
  <Window.DataContext><vm:MainViewModel/></Window.DataContext>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#102A43"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="LELTÁRKEZELŐ" FontWeight="Bold" Foreground="White" FontSize="18" Margin="8,12,8,8"/><TextBlock Text="Egyetemi eszköznyilvántartás" Foreground="#9FB3C8" Margin="8,0,8,28"/><Button Content="Áttekintés" Click="Overview_Click" Background="Transparent" HorizontalContentAlignment="Left"/><Button Content="Leltározás" Click="Inventory_Click" Background="Transparent" HorizontalContentAlignment="Left"/><Button Content="Eszközök" Click="Equipment_Click" Background="Transparent" HorizontalContentAlignment="Left"/><Button Content="Összehasonlítás" Click="Comparison_Click" Background="Transparent" HorizontalContentAlignment="Left"/><Button Content="Import és riportok" Click="Reports_Click" Background="Transparent" HorizontalContentAlignment="Left"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Bárkányi Máté · Leltározó&#x0a;Demo mód · Online" Foreground="#D9E2EC" Margin="8"/></DockPanel></Border>
    <Grid Grid.Column="1" Margin="32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="{Binding CurrentPage}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="2026. évi intézményi leltár · Nyitott időszak" Foreground="#627D98" Margin="0,5,0,20"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="● Online" Foreground="#039855" VerticalAlignment="Top" Margin="0,12"/></DockPanel>
      <Grid Grid.Row="1">
        <Grid x:Name="OverviewPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><UniformGrid Columns="3" Margin="0,0,0,20"><Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="ELŐREHALADÁS" Foreground="#627D98"/><TextBlock Text="{Binding Progress, StringFormat={}{0}%}" FontSize="32" FontWeight="Bold"/><ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"/></StackPanel></Border><Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="MEGTALÁLT TÉTELEK" Foreground="#627D98"/><TextBlock><Run Text="{Binding FoundCount}" FontSize="32" FontWeight="Bold"/><Run Text=" / "/><Run Text="{Binding TotalCount}"/></TextBlock><TextBlock Text="Eszközrekordok" Foreground="#627D98"/></StackPanel></Border><Border Background="White" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="AKTÍV KÖRZET" Foreground="#627D98"/><TextBlock Text="A épület" FontSize="24" FontWeight="Bold"/><TextBlock Text="112-es helyiség"/></StackPanel></Border></UniformGrid><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="Leltári állapot" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid ItemsSource="{Binding Equipment}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Kód" Binding="{Binding Code}"/><DataGridTextColumn Header="Eszköz" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Helyiség" Binding="{Binding Room}"/><DataGridTextColumn Header="Elvárt" Binding="{Binding Expected}"/><DataGridTextColumn Header="Beolvasva" Binding="{Binding Counted}"/><DataGridTextColumn Header="Állapot" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>
        <Grid x:Name="InventoryPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" CornerRadius="8" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Leltári időszak" Foreground="#627D98"/><ComboBox SelectedIndex="0" Margin="0,4"><ComboBoxItem Content="2026. évi intézményi leltár"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="Leltárkörzet" Foreground="#627D98"/><ComboBox SelectedIndex="0" Margin="0,4"><ComboBoxItem Content="A épület"/><ComboBoxItem Content="B épület"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Helyiség" Foreground="#627D98"/><ComboBox SelectedIndex="0" Margin="0,4"><ComboBoxItem Content="112"/><ComboBoxItem Content="114"/><ComboBoxItem Content="205"/></ComboBox></StackPanel></Grid></Border><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="24" Margin="0,16,0,0"><StackPanel><TextBlock Text="Vonalkód beolvasása" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Az olvasó billentyűzetként működik. Ctrl+V-vel is beilleszthető egy kód." Foreground="#627D98" Margin="0,4,0,12"/><DockPanel><Button Content="Rögzítés" Command="{Binding ScanCommand}" DockPanel.Dock="Right"/><TextBox Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}" MinWidth="340" VerticalContentAlignment="Center" ToolTip="Példa: LT-00142"/></DockPanel><TextBlock Text="{Binding Feedback}" Margin="4,12,4,0" FontWeight="SemiBold"/><TextBlock Text="Zöld: sikeres · narancs: ismételt/többlet · piros: ismeretlen · sárga: más körzet" Foreground="#627D98" Margin="4,4"/></StackPanel></Border><Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="A helyiség várható eszközei" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid ItemsSource="{Binding Equipment}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Kód" Binding="{Binding Code}"/><DataGridTextColumn Header="Megnevezés" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Elvárt" Binding="{Binding Expected}"/><DataGridTextColumn Header="Beolvasva" Binding="{Binding Counted}"/><DataGridTextColumn Header="Hiány" Binding="{Binding Missing}"/><DataGridTextColumn Header="Állapot" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>
        <Grid x:Name="EquipmentPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="+ Új eszköz" DockPanel.Dock="Right"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="320" ToolTip="Keresés kódra vagy megnevezésre"/><ComboBox Width="135" Margin="8,4" SelectedIndex="0"><ComboBoxItem Content="Minden típus"/><ComboBoxItem Content="Informatika"/><ComboBoxItem Content="Bútor"/></ComboBox><ComboBox Width="135" Margin="4" SelectedIndex="0"><ComboBoxItem Content="Minden állapot"/><ComboBoxItem Content="Aktív"/><ComboBoxItem Content="Selejtezett"/></ComboBox></DockPanel><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16"><DataGrid ItemsSource="{Binding FilteredEquipment}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Elsődleges kód" Binding="{Binding Code}"/><DataGridTextColumn Header="Megnevezés" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Körzet" Binding="{Binding District}"/><DataGridTextColumn Header="Helyiség" Binding="{Binding Room}"/><DataGridTextColumn Header="Felelős" Binding="{Binding Responsible}"/><DataGridTextColumn Header="Típus" Binding="{Binding Type}"/><DataGridTextColumn Header="Eszközállapot" Binding="{Binding LifecycleStatus}"/></DataGrid.Columns></DataGrid></Border></Grid>
        <Grid x:Name="ComparisonPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" CornerRadius="8" Padding="20"><DockPanel><Button Content="Export Excelbe" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><ComboBox Width="260" SelectedIndex="0"><ComboBoxItem Content="2026. évi intézményi leltár"/></ComboBox><ComboBox Width="150" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="Minden körzet"/><ComboBoxItem Content="A épület"/></ComboBox><ComboBox Width="170" SelectedIndex="0"><ComboBoxItem Content="Minden eltérés"/><ComboBoxItem Content="Hiányzó"/><ComboBoxItem Content="Többlet"/><ComboBoxItem Content="Más körzet"/></ComboBox></StackPanel></DockPanel></Border><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Eltérések és egyezések" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid ItemsSource="{Binding Equipment}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Eszköz" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Várt körzet" Binding="{Binding District}"/><DataGridTextColumn Header="Leltározott helyiség" Binding="{Binding Room}"/><DataGridTextColumn Header="Elvárt" Binding="{Binding Expected}"/><DataGridTextColumn Header="Beolvasva" Binding="{Binding Counted}"/><DataGridTextColumn Header="Eredmény" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid><TextBlock Text="A lezárt időszakok csak olvashatók; minden leolvasás és helyváltozás előzménye megőrzendő." Foreground="#627D98" Margin="0,12,0,0"/></StackPanel></Border></Grid>
        <Grid x:Name="ReportsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="Excel forrásadat importálása" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A fájl kiválasztása után a szerver validálja és importnaplóban rögzíti az eredményt." Foreground="#627D98" Margin="0,4,0,12"/><DockPanel><Button Content="Import indítása" DockPanel.Dock="Right"/><TextBox IsReadOnly="True" Text="Nincs kiválasztott Excel-fájl"/></DockPanel></StackPanel></Border><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Riportok" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox><ListBoxItem Content="Hiányzó eszközök körzetenként"/><ListBoxItem Content="Mennyiségi eltérések"/><ListBoxItem Content="Más körzetből előkerült eszközök"/><ListBoxItem Content="Helyiségenkénti leltárlista"/><ListBoxItem Content="Felelős személy szerinti lista"/><ListBoxItem Content="Eszközállapotok és változástörténet"/></ListBox><Button Content="Kijelölt riport exportálása (.xlsx)" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
