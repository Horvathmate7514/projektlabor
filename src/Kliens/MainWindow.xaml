<Window x:Class="Leltarkezelo.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Leltarkezelo.Client.ViewModels"
        xmlns:views="clr-namespace:Leltarkezelo.Client.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FoAblakViewModel}"
        Title="Leltárkezelő" Height="800" Width="1320" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Hatter}" Language="hu-HU"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Szoveg}">
  <Grid>
    <!-- Bejelentkezés -->
    <views:BejelentkezesNezet DataContext="{Binding Bejelentkezes}"
                              Visibility="{Binding DataContext.Munkamenet.Bejelentkezve, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Lathato}, ConverterParameter=Fordit}"/>

    <!-- A program felülete -->
    <Grid Visibility="{Binding Munkamenet.Bejelentkezve, Converter={StaticResource Lathato}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource Oldalsav}">
        <DockPanel Margin="14,18">
          <StackPanel DockPanel.Dock="Top" Margin="8,4,8,24">
            <TextBlock Text="LELTÁRKEZELŐ" FontWeight="Bold" Foreground="White" FontSize="18"/>
            <TextBlock Text="Egyetemi eszköznyilvántartás" Foreground="{StaticResource OldalsavHalvany}" Margin="0,4,0,0"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#F79009"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SzerverElerheto}" Value="True"><Setter Property="Fill" Value="#12B76A"/></DataTrigger>
                      <DataTrigger Binding="{Binding SzerverElerheto}" Value="False"><Setter Property="Fill" Value="#F04438"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding SzerverAllapotSzoveg}" Foreground="{StaticResource OldalsavHalvany}"/>
            </StackPanel>
            <TextBlock Text="{Binding Munkamenet.Felhasznalo.Nev}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Munkamenet.SzerepkorNev}" Foreground="{StaticResource OldalsavHalvany}" Margin="0,2,0,10"/>
            <Button Content="Kijelentkezés" Command="{Binding KijelentkezesCommand}" Style="{StaticResource OldalsavGomb}"
                    HorizontalAlignment="Left" Margin="0"/>
          </StackPanel>

          <ListBox ItemsSource="{Binding Menu}" SelectedItem="{Binding KivalasztottMenu}" Background="Transparent"
                   BorderThickness="0" AutomationProperties.Name="Menü"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource MenuElem}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Cim}"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:MenuPont}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Background="{StaticResource OldalsavKiemelt}"
                          Visibility="{Binding Kesobb, Converter={StaticResource Lathato}}">
                    <TextBlock Text="később" FontSize="11" Foreground="{StaticResource OldalsavHalvany}"/>
                  </Border>
                  <TextBlock Text="{Binding Cim}" FontSize="14"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28,20,28,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
          <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                       Visibility="{Binding AktualisOldal.Foglalt, Converter={StaticResource Lathato}}"/>
          <TextBlock Text="{Binding AktualisOldal.Cim}" Style="{StaticResource OldalCim}"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource HibaSav}"
                Visibility="{Binding AktualisOldal.Hiba, Converter={StaticResource Lathato}}">
          <TextBlock Text="{Binding AktualisOldal.Hiba}" Foreground="{StaticResource Veszely}" TextWrapping="Wrap"/>
        </Border>
        <ContentControl Grid.Row="2" Content="{Binding AktualisOldal}" Focusable="False"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
