<Window x:Class="Leltarkezelo.Client.Views.SzovegBekeroAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource Felulet}" FontFamily="Segoe UI" FontSize="13">
  <StackPanel Margin="20">
    <TextBlock x:Name="KerdesSzoveg" TextWrapping="Wrap" Margin="4,0,4,8"/>
    <TextBox x:Name="Mezo" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" VerticalContentAlignment="Top"
             TextChanged="SzovegValtozott"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Mégse" IsCancel="True" Style="{StaticResource MasodlagosGomb}"/>
      <Button x:Name="RendbenGomb" Content="Rendben" IsDefault="True" IsEnabled="False" Click="Rendben"/>
    </StackPanel>
  </StackPanel>
</Window>
