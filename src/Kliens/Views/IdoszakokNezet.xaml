<UserControl x:Class="Leltarkezelo.Client.Views.IdoszakokNezet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
      <DataTrigger Binding="{Binding Foglalt}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
    </Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Content="Frissítés" Command="{Binding FrissitesCommand}" Style="{StaticResource MasodlagosGomb}"/>
        <ComboBox ItemsSource="{Binding Statuszok}" SelectedItem="{Binding Statusz}" DisplayMemberPath="Nev"
                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Időszak állapotszűrő"/>
      </DockPanel>
      <TextBlock Text="{Binding Tajekoztatas}" Style="{StaticResource Halvany}" Margin="0,0,0,10"
                 Visibility="{Binding Tajekoztatas, Converter={StaticResource Lathato}}"/>
      <TextBlock Text="Az időszakokat megtekintheted. Létrehozásukhoz, megnyitásukhoz és lezárásukhoz Admin vagy Leltárfelelős szerepkör szükséges."
                 Style="{StaticResource Halvany}" Margin="0,0,0,10"
                 Visibility="{Binding Kezelhet, Converter={StaticResource Lathato}, ConverterParameter=Fordit}"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Kartya}" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Text="{Binding Kivalasztott.Megnevezes, TargetNullValue=Válassz egy időszakot.}" FontWeight="SemiBold"/>
          <WrapPanel Margin="0,4,0,0" Visibility="{Binding Kivalasztott, Converter={StaticResource Lathato}}">
            <TextBlock Text="{Binding Kivalasztott.Statusz, StringFormat=Állapot: {0}}" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding Kivalasztott.ElvartTetelek, StringFormat=Elvárt tételek: {0}}" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding Kivalasztott.Lezarva, StringFormat=Lezárva: {0}}"/>
          </WrapPanel>
          <WrapPanel Visibility="{Binding Kezelhet, Converter={StaticResource Lathato}}" Margin="0,8,0,0">
            <Button Content="Időszak megnyitása" Command="{Binding NyitasCommand}" AutomationProperties.AutomationId="IdoszakNyitas"/>
            <Button Content="Időszak lezárása" Command="{Binding LezarasCommand}" Style="{StaticResource MasodlagosGomb}" AutomationProperties.AutomationId="IdoszakLezaras"/>
          </WrapPanel>
          <TextBlock Text="A lezárt időszak nem nyitható meg újra. Leolvasásai a Leolvasási naplóban tekinthetők meg." Style="{StaticResource Halvany}" Margin="0,6,0,0"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Idoszakok}" SelectedItem="{Binding Kivalasztott}" AutomationProperties.Name="Leltáridőszakok listája">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Megnevezés" Binding="{Binding Megnevezes}" Width="*" MinWidth="160"/>
            <DataGridTextColumn Header="Típus" Binding="{Binding Tipus}" Width="95"/>
            <DataGridTextColumn Header="Állapot" Binding="{Binding Statusz}" Width="95"/>
            <DataGridTextColumn Header="Kezdete" Binding="{Binding Kezdete}" Width="110"/>
            <DataGridTextColumn Header="Vége" Binding="{Binding Vege}" Width="110"/>
            <DataGridTextColumn Header="Elvárt tételek" Binding="{Binding ElvartTetelek}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Kartya}" Margin="0,12,0,0" Padding="14"
            Visibility="{Binding Kezelhet, Converter={StaticResource Lathato}}">
      <StackPanel>
        <TextBlock Text="Új leltáridőszak" Style="{StaticResource KartyaCim}"/>
        <WrapPanel>
          <StackPanel Width="260"><TextBlock Text="Megnevezés *" Style="{StaticResource Cimke}"/>
            <TextBox Text="{Binding Megnevezes, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Időszak megnevezése"/></StackPanel>
          <StackPanel Width="135"><TextBlock Text="Típus" Style="{StaticResource Cimke}"/>
            <ComboBox ItemsSource="{Binding Tipusok}" SelectedItem="{Binding Tipus}" DisplayMemberPath="Nev" AutomationProperties.Name="Időszak típusa"/></StackPanel>
          <StackPanel Width="150"><TextBlock Text="Kezdete *" Style="{StaticResource Cimke}"/>
            <DatePicker SelectedDate="{Binding Kezdete}" Margin="4" AutomationProperties.Name="Időszak kezdete"/></StackPanel>
          <StackPanel Width="150"><TextBlock Text="Vége (opcionális)" Style="{StaticResource Cimke}"/>
            <DatePicker SelectedDate="{Binding Vege}" Margin="4" AutomationProperties.Name="Időszak vége"/></StackPanel>
          <Button Content="Létrehozás" Command="{Binding LetrehozasCommand}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="IdoszakLetrehozas"/>
        </WrapPanel>
        <TextBlock Text="Az új időszak Tervezett állapotú. Megnyitáskor készül el az elvárt állomány pillanatképe." Style="{StaticResource Halvany}" Margin="4,6,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
