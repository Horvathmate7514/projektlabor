<UserControl x:Class="Leltarkezelo.Client.Views.LeolvasasiNaploNezet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Style="{StaticResource Kartya}" VerticalAlignment="Top"
            Visibility="{Binding Engedelyezett, Converter={StaticResource Lathato}, ConverterParameter=Fordit}">
      <TextBlock Text="A leolvasási naplóhoz Admin, Leltárfelelős vagy Leltározó szerepkör szükséges." TextWrapping="Wrap"/>
    </Border>
    <Grid Visibility="{Binding Engedelyezett, Converter={StaticResource Lathato}}">
      <Grid.Style><Style TargetType="Grid"><Style.Triggers>
        <DataTrigger Binding="{Binding Foglalt}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
      </Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Kartya}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <WrapPanel>
            <StackPanel Width="300"><TextBlock Text="Leltáridőszak" Style="{StaticResource Cimke}"/>
              <ComboBox ItemsSource="{Binding Idoszakok}" SelectedItem="{Binding Idoszak}" AutomationProperties.Name="Napló időszaka">
                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Megnevezes}"/>
                </Style></ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Megnevezes, Mode=OneWay}"/> · <Run Text="{Binding Statusz, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox></StackPanel>
            <StackPanel Width="260"><TextBlock Text="Leolvasás körzete" Style="{StaticResource Cimke}"/>
              <ComboBox ItemsSource="{Binding Korzetek}" SelectedItem="{Binding Korzet}" DisplayMemberPath="Nev" AutomationProperties.Name="Napló körzetszűrő"/></StackPanel>
            <Button Content="Frissítés" Command="{Binding FrissitesCommand}" Style="{StaticResource MasodlagosGomb}" VerticalAlignment="Bottom"/>
          </WrapPanel>
          <WrapPanel Margin="4,8,0,6">
            <CheckBox Content="Csak a saját leolvasásaim" IsChecked="{Binding CsakSajat}" Margin="0,0,20,0"/>
            <CheckBox Content="Sztornózottakkal együtt" IsChecked="{Binding SztornozottakkalEgyutt}"/>
          </WrapPanel>
          <TextBlock Text="Nyitott és korábbi, lezárt időszakok is böngészhetők. A lista a jogosult körzetekre korlátozódik; a sztornózott sorok nem számítanak bele a leltár mennyiségébe." Style="{StaticResource Halvany}"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Kartya}" Padding="10">
        <DataGrid ItemsSource="{Binding Sorok}" AutomationProperties.Name="Leolvasási napló tételei">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Időpont" Binding="{Binding Idopont}" Width="155"/>
            <DataGridTextColumn Header="Kód" Binding="{Binding Kod}" Width="120"/>
            <DataGridTextColumn Header="Eszköz" Binding="{Binding Eszkoz}" Width="*" MinWidth="150"/>
            <DataGridTextColumn Header="Körzet" Binding="{Binding Korzet}" Width="80"/>
            <DataGridTextColumn Header="Mennyiség" Binding="{Binding Mennyiseg}" Width="80"/>
            <DataGridTextColumn Header="Minősítés" Binding="{Binding Minosites}" Width="120"/>
            <DataGridTextColumn Header="Állapot" Binding="{Binding Statusz}" Width="95"/>
            <DataGridTextColumn Header="Bevitel" Binding="{Binding BeviteliMod}" Width="95"/>
            <DataGridTextColumn Header="Felhasználó" Binding="{Binding Felhasznalo}" Width="140"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <WrapPanel>
          <ComboBox ItemsSource="{Binding OldalMeretek}" SelectedItem="{Binding OldalMeret}" Width="75" AutomationProperties.Name="Napló oldalmérete"/>
          <Button Content="« Első" Command="{Binding OldalraCommand}" CommandParameter="elso" IsEnabled="{Binding VanElozo}" Style="{StaticResource MasodlagosGomb}"/>
          <Button Content="‹ Előző" Command="{Binding OldalraCommand}" CommandParameter="elozo" IsEnabled="{Binding VanElozo}" Style="{StaticResource MasodlagosGomb}"/>
          <Button Content="Következő ›" Command="{Binding OldalraCommand}" CommandParameter="kovetkezo" IsEnabled="{Binding VanKovetkezo}" Style="{StaticResource MasodlagosGomb}"/>
          <Button Content="Utolsó »" Command="{Binding OldalraCommand}" CommandParameter="utolso" IsEnabled="{Binding VanKovetkezo}" Style="{StaticResource MasodlagosGomb}"/>
        </WrapPanel>
        <TextBlock Text="{Binding LapozasSzoveg}" Style="{StaticResource Halvany}" Margin="4,4,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
