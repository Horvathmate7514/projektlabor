<UserControl x:Class="Leltarkezelo.Client.Views.LeltarozasNezet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Leltarkezelo.Client.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LeltarozasViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Modifiers="Control+Shift" Key="R" Command="{Binding DemoErvenyesCommand}"/>
    <KeyBinding Modifiers="Control+Shift" Key="E" Command="{Binding DemoErvenytelenCommand}"/>
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Időszak, körzet, helyiség -->
    <Border Style="{StaticResource Kartya}" Padding="14,10" Visibility="{Binding Engedelyezett, Converter={StaticResource Lathato}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Leltáridőszak (nyitott)" Style="{StaticResource Cimke}" Margin="4,0"/>
          <ComboBox ItemsSource="{Binding Idoszakok}" SelectedItem="{Binding Idoszak}" DisplayMemberPath="Megnevezes"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="10,0">
          <TextBlock Text="Aktív leltárkörzet" Style="{StaticResource Cimke}" Margin="4,0"/>
          <ComboBox ItemsSource="{Binding Korzetek}" SelectedItem="{Binding Korzet}">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem">
                <Setter Property="IsEnabled" Value="{Binding Leltarozhato}"/>
                <Setter Property="ToolTip" Value="{Binding SzervezetiEgyseg}"/>
              </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock><Run Text="{Binding Kod, Mode=OneWay}" FontWeight="SemiBold"/> – <Run Text="{Binding Nev, Mode=OneWay}"/></TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Helyiség (nem kötelező)" Style="{StaticResource Cimke}" Margin="4,0"/>
          <ComboBox ItemsSource="{Binding Helyisegek}" SelectedItem="{Binding Helyiseg}" DisplayMemberPath="Nev"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Background="#FFFAEB" BorderBrush="#F79009" BorderThickness="1" CornerRadius="6" Padding="12,8"
            Visibility="{Binding Figyelmeztetes, Converter={StaticResource Lathato}}">
      <TextBlock Text="{Binding Figyelmeztetes}" Foreground="#93370D" TextWrapping="Wrap"/>
    </Border>

    <!-- Beolvasás és visszajelzés -->
    <Border Grid.Row="2" Style="{StaticResource Kartya}" Margin="0,12,0,0" Padding="20" IsEnabled="{Binding KeszenAll}"
            Visibility="{Binding Engedelyezett, Converter={StaticResource Lathato}}">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Allapotsor}" Style="{StaticResource Halvany}" VerticalAlignment="Center"/>
          <TextBlock Text="Vonalkód beolvasása" Style="{StaticResource KartyaCim}" Margin="0"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Halvany}" Margin="0,4,0,10"
                   Text="Az olvasó billentyűzetként ír, és Entert küld; a kurzor mindig ebben a mezőben marad. Kódot Ctrl+V-vel is beilleszthetsz."/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Rögzítés" Command="{Binding RogzitesCommand}" Padding="22,9"/>
          <StackPanel DockPanel.Dock="Right" Width="90">
            <TextBlock Text="Mennyiség" Style="{StaticResource Cimke}" Margin="4,0"/>
            <TextBox Text="{Binding Mennyiseg, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"
                     ToolTip="Mennyiséges eszköznél a megszámolt darabszám (pl. 27 szék); egyébként 1">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding RogzitesCommand}"/>
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Kód" Style="{StaticResource Cimke}" Margin="4,0"/>
            <TextBox x:Name="KodMezo" Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontFamily="Consolas"
                     ToolTip="Bármely aktív kód: SAP szám, leltári szám, gyári szám, belső vonalkód">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding RogzitesCommand}"/>
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
        </DockPanel>

        <Border Margin="4,14,4,0" CornerRadius="6" Padding="14,12" BorderThickness="4,1,1,1"
                Background="{Binding Jelzes, Converter={StaticResource JelzesSzin}, ConverterParameter=Hatter}"
                BorderBrush="{Binding Jelzes, Converter={StaticResource JelzesSzin}, ConverterParameter=Szegely}">
          <StackPanel>
            <TextBlock Text="{Binding Visszajelzes}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{Binding Jelzes, Converter={StaticResource JelzesSzin}}"/>
            <TextBlock Text="{Binding VisszajelzesReszlet}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{Binding Jelzes, Converter={StaticResource JelzesSzin}}"
                       Visibility="{Binding VisszajelzesReszlet, Converter={StaticResource Lathato}}"/>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,10,0,0">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <Button Content="Demó: érvényes kód" Command="{Binding DemoErvenyesCommand}" Style="{StaticResource MasodlagosGomb}"
                    ToolTip="Olvasó nélküli bemutatóhoz: a körzet egy még be nem olvasott eszközének kódja (Ctrl+Shift+R)"/>
            <Button Content="Demó: érvénytelen kód" Command="{Binding DemoErvenytelenCommand}" Style="{StaticResource MasodlagosGomb}"
                    ToolTip="Egyetlen eszközhöz sem tartozó tesztkód (Ctrl+Shift+E)"/>
          </StackPanel>
          <TextBlock Text="{Binding Statisztika}" Style="{StaticResource Halvany}" VerticalAlignment="Center" TextAlignment="Right"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Halvany}" FontSize="11" Margin="4,6,4,0"
                   Text="Zöld: rendben · narancs: ismételt · sárga: más körzet · lila: többlet vagy nem aktív eszköz · piros: ismeretlen kód vagy hiba"/>
      </StackPanel>
    </Border>

    <!-- Legutóbbi saját beolvasások -->
    <Border Grid.Row="3" Style="{StaticResource Kartya}" Margin="0,12,0,0" Padding="14,12"
            Visibility="{Binding Engedelyezett, Converter={StaticResource Lathato}}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="Frissítés" Command="{Binding FrissitesCommand}" Style="{StaticResource LinkGomb}"/>
          <TextBlock Text="Legutóbbi beolvasásaim ebben az időszakban" Style="{StaticResource KartyaCim}" Margin="0"/>
        </DockPanel>
        <DataGrid ItemsSource="{Binding UtolsoBeolvasasok}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Idő" Binding="{Binding Ido}" Width="75"/>
            <DataGridTextColumn Header="Kód" Binding="{Binding Kod}" Width="130"/>
            <DataGridTextColumn Header="Eszköz" Binding="{Binding Eszkoz}" Width="2*"/>
            <DataGridTemplateColumn Header="Eredmény" Width="125">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="10" Padding="8,1" HorizontalAlignment="Left"
                          Background="{Binding Jelzes, Converter={StaticResource JelzesSzin}, ConverterParameter=Hatter}">
                    <TextBlock Text="{Binding MinositesNev}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{Binding Jelzes, Converter={StaticResource JelzesSzin}}"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Menny." Binding="{Binding Mennyiseg}" Width="60"/>
            <DataGridTextColumn Header="Mód" Binding="{Binding Mod}" Width="85"/>
            <DataGridTextColumn Header="Körzet" Binding="{Binding Korzet}" Width="75"/>
            <DataGridTemplateColumn Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Sztornó" Style="{StaticResource LinkGomb}"
                          Command="{Binding DataContext.SztornoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Visibility="{Binding Sztornozva, Converter={StaticResource Lathato}, ConverterParameter=Fordit}"
                          ToolTip="A leolvasás visszavonása indoklással (pl. véletlen dupla beolvasás)"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
