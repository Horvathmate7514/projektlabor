<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Szinek.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Szövegek -->
  <Style TargetType="TextBlock" x:Key="OldalCim">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Szoveg}"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="KartyaCim">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Szoveg}"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="Cimke">
    <Setter Property="Foreground" Value="{StaticResource SzovegHalvany}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="Halvany">
    <Setter Property="Foreground" Value="{StaticResource SzovegHalvany}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="Szam">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource Szoveg}"/>
  </Style>

  <!-- Kártya: fehér, lekerekített felület -->
  <Style TargetType="Border" x:Key="Kartya">
    <Setter Property="Background" Value="{StaticResource Felulet}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Szegely}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="18"/>
  </Style>

  <!-- Gombok -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Elsodleges}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource Elsodleges}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Hat" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hat" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Hat" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Hat" Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Hat" Property="BorderBrush" Value="{StaticResource ElsodlegesSotet}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" x:Key="MasodlagosGomb" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Felulet}"/>
    <Setter Property="Foreground" Value="{StaticResource Szoveg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Szegely}"/>
  </Style>
  <Style TargetType="Button" x:Key="LinkGomb" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Elsodleges}"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style TargetType="Button" x:Key="OldalsavGomb" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource OldalsavHalvany}"/>
    <Setter Property="Foreground" Value="{StaticResource OldalsavSzoveg}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>

  <!-- Beviteli mezők -->
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="BorderBrush" Value="{StaticResource Szegely}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource Elsodleges}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="BorderBrush" Value="{StaticResource Szegely}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="4,8"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- Táblázat -->
  <Style TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SorKiemeles}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="{StaticResource Felulet}"/>
    <Setter Property="RowBackground" Value="{StaticResource Felulet}"/>
    <Setter Property="RowHeight" Value="30"/>
    <Setter Property="ColumnHeaderHeight" Value="34"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Hatter}"/>
    <Setter Property="Foreground" Value="{StaticResource SzovegHalvany}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderBrush" Value="{StaticResource Szegely}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource ElsodlegesHalvany}"/>
        <Setter Property="Foreground" Value="{StaticResource Szoveg}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Oldalsó menü -->
  <Style TargetType="ListBoxItem" x:Key="MenuElem">
    <Setter Property="Foreground" Value="{StaticResource OldalsavSzoveg}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Hat" Background="Transparent" CornerRadius="6" Padding="12,9" Margin="0,2">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hat" Property="Background" Value="{StaticResource OldalsavKiemelt}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Hat" Property="Background" Value="{StaticResource Elsodleges}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Visszajelző sáv (hiba az oldal tetején) -->
  <Style TargetType="Border" x:Key="HibaSav">
    <Setter Property="Background" Value="{StaticResource VeszelyHalvany}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Veszely}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
</ResourceDictionary>
