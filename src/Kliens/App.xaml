<Application x:Class="Leltarkezelo.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Leltarkezelo.Client.ViewModels"
             xmlns:views="clr-namespace:Leltarkezelo.Client.Views"
             xmlns:konv="clr-namespace:Leltarkezelo.Client.Konverterek"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Stilusok/Vezerlok.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <konv:JelzesSzinKonverter x:Key="JelzesSzin"/>
      <konv:LathatosagKonverter x:Key="Lathato"/>

      <!-- Nézetmodell → nézet: a főablak a kiválasztott oldal nézetmodelljét jeleníti meg -->
      <DataTemplate DataType="{x:Type vm:LeltarozasViewModel}"><views:LeltarozasNezet/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:EszkozokViewModel}"><views:EszkozokNezet/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ImportViewModel}"><views:ImportNezet/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:KesobbViewModel}"><views:KesobbNezet/></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
