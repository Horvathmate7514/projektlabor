<Application x:Class="Leltarkezelo.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Primary" Color="#175CD3"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Background" Color="#F7F9FC"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/>
      <Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/></Style>
  </Application.Resources>
</Application>
